DB_URL=jdbc:mysql://localhost:3306/ai_interview_prep?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=interview_user
DB_PASSWORD=change_me
GEMINI_API_KEY=replace_with_your_google_ai_studio_key
GEMINI_MODEL=gemini-2.5-flash
RESUME_STORAGE_DIR=./data/resumes
CODE_RUNNER_BASE_URL=http://localhost:8090
CODE_RUNNER_API_KEY=replace_with_runner_service_token
CODE_RUNNER_CONNECT_TIMEOUT=PT3S
CODE_RUNNER_REQUEST_TIMEOUT=PT10S
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P7D
# Set true when the public application is served over HTTPS.
AUTH_COOKIE_SECURE=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW=PT1M
RATE_LIMIT_GENERAL_REQUESTS=300
RATE_LIMIT_AUTH_REQUESTS=60
RATE_LIMIT_AI_REQUESTS=60
RATE_LIMIT_MAX_TRACKED_KEYS=10000
